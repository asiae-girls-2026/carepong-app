{
  "name": "care-pong",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac zip"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "productName": "CarePong",
  "description": "케어퐁 — 바탕화면 스트레스 케어 펫 (MVP)",
  "build": {
    "appId": "com.chaewon.carepong",
    "productName": "CarePong",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-win-${version}.${ext}"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "resources/collector.exe",
        "to": "collector.exe"
      }
    ]
  }
}
